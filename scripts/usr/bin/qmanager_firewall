#!/bin/sh
# qmanager_firewall — Port firewall for QManager web UI (chain-based)
#
# Restricts HTTP/HTTPS access to trusted interfaces only (IPv4 and IPv6). All rules live in
# a dedicated user chain (QMANAGER_FW) hooked into INPUT, so start/stop is
# atomic and cannot leak rules across upgrades. Replaces SimpleAdmin's
# simplefirewall as a QManager-managed service.
#
# Usage: qmanager_firewall {start|stop|restart|ensure}
#
# Protected ports: 80 (HTTP), 443 (HTTPS)
# Trusted interfaces: lo, bridge0, eth0, tailscale0 (if installed)
# SSH (22) is intentionally NOT blocked — emergency access must remain open.
#
# Service: qmanager-firewall.service (Type=oneshot, RemainAfterExit=yes)

PORTS="80 443"
TRUSTED="lo bridge0 eth0"

if [ -x /usrdata/tailscale/tailscale ]; then
    TRUSTED="$TRUSTED tailscale0"
fi

CHAIN="QMANAGER_FW"

# Ports the user closed to the cellular side from System Settings -> Security Check.
# One "tcp 22" / "udp 5353" line per port; applies to IPv4 and IPv6 on rmnet+ only.
WAN_CHAIN="QMANAGER_WAN"
WAN_CONF="${QM_WAN_BLOCK_CONF:-/etc/qmanager/wan_block.conf}"

# Stealth (flag file): no ping replies and no "nothing here" replies to the cellular side.
# Only the modem's own INPUT/OUTPUT: forwarded traffic (the router in IP Passthrough) is untouched.
STEALTH_FLAG="${QM_STEALTH_FLAG:-/etc/qmanager/wan_stealth}"
ST_IN="QMANAGER_STEALTH"
ST_OUT="QMANAGER_STEALTH_OUT"
# LAN IPv6 off (flag file): no IPv6 forwarding for bridge0 and no RA / DHCPv6 sent to it.
LAN6_FLAG="${QM_LAN6_OFF_FLAG:-/etc/qmanager/lan_ipv6_off}"
LAN6_FWD="QMANAGER_LAN6"
LAN6_OUT="QMANAGER_LAN6_OUT"

ensure_chain() {
    iptables -t filter -N "$CHAIN" 2>/dev/null || true
}

unhook_chain() {
    # Remove every existing INPUT->CHAIN jump (handles past duplicate hooks)
    while iptables -C INPUT -j "$CHAIN" 2>/dev/null; do
        iptables -D INPUT -j "$CHAIN" 2>/dev/null || break
    done
}

drop_chain() {
    iptables -F "$CHAIN" 2>/dev/null || true
    iptables -X "$CHAIN" 2>/dev/null || true
}

# Drain INPUT-direct rules from the pre-chain implementation.
# Loops per rule because -D removes only one match per call.
cleanup_legacy_input_rules() {
    iface=""
    port=""
    for iface in lo bridge0 eth0 tailscale0 rmnet_data0; do
        for port in $PORTS; do
            while iptables -C INPUT -i "$iface" -p tcp --dport "$port" -j ACCEPT 2>/dev/null; do
                iptables -D INPUT -i "$iface" -p tcp --dport "$port" -j ACCEPT 2>/dev/null || break
            done
            while iptables -C INPUT -i "$iface" -p tcp --dport "$port" -j DROP 2>/dev/null; do
                iptables -D INPUT -i "$iface" -p tcp --dport "$port" -j DROP 2>/dev/null || break
            done
        done
    done
    for port in $PORTS; do
        while iptables -C INPUT -p tcp --dport "$port" -j DROP 2>/dev/null; do
            iptables -D INPUT -p tcp --dport "$port" -j DROP 2>/dev/null || break
        done
    done
}

do_start() {
    cleanup_legacy_input_rules
    ensure_chain
    iptables -F "$CHAIN" 2>/dev/null || true
    for iface in $TRUSTED; do
        for port in $PORTS; do
            iptables -A "$CHAIN" -i "$iface" -p tcp --dport "$port" -j ACCEPT
        done
    done
    for port in $PORTS; do
        iptables -A "$CHAIN" -p tcp --dport "$port" -j DROP
    done
    unhook_chain
    iptables -I INPUT 1 -j "$CHAIN"
    web6_start
    wan_start
    stealth_start
    lan6_start
}

# The same web UI protection for IPv6: a [::] socket is reachable over the carrier's public IPv6 otherwise.
web6_stop() {
    command -v ip6tables >/dev/null 2>&1 || return 0
    while ip6tables -C INPUT -j "$CHAIN" 2>/dev/null; do
        ip6tables -D INPUT -j "$CHAIN" 2>/dev/null || break
    done
    ip6tables -F "$CHAIN" 2>/dev/null || true
    ip6tables -X "$CHAIN" 2>/dev/null || true
}

web6_start() {
    command -v ip6tables >/dev/null 2>&1 || return 0
    web6_stop
    ip6tables -N "$CHAIN" 2>/dev/null || true
    for iface in $TRUSTED; do
        for port in $PORTS; do
            ip6tables -A "$CHAIN" -i "$iface" -p tcp --dport "$port" -j ACCEPT
        done
    done
    for port in $PORTS; do
        ip6tables -A "$CHAIN" -p tcp --dport "$port" -j DROP
    done
    ip6tables -I INPUT 1 -j "$CHAIN"
}

wan_tables() {
    echo iptables
    command -v ip6tables >/dev/null 2>&1 && echo ip6tables
}

wan_stop() {
    for t in $(wan_tables); do
        while $t -C INPUT -j "$WAN_CHAIN" 2>/dev/null; do
            $t -D INPUT -j "$WAN_CHAIN" 2>/dev/null || break
        done
        $t -F "$WAN_CHAIN" 2>/dev/null || true
        $t -X "$WAN_CHAIN" 2>/dev/null || true
    done
}

wan_start() {
    wan_stop
    [ -s "$WAN_CONF" ] || return 0
    for t in $(wan_tables); do
        $t -N "$WAN_CHAIN" 2>/dev/null || true
        while read -r proto port _rest; do
            case "$proto" in tcp|udp) ;; *) continue ;; esac
            case "$port" in ''|*[!0-9]*) continue ;; esac
            [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || continue
            $t -A "$WAN_CHAIN" -i rmnet+ -p "$proto" --dport "$port" -j DROP
        done < "$WAN_CONF"
        $t -I INPUT 1 -j "$WAN_CHAIN"
    done
}

# _hook <tool> <builtin chain> <our chain> on|off — one jump at position 1, never duplicated.
_hook() {
    while $1 -C "$2" -j "$3" 2>/dev/null; do $1 -D "$2" -j "$3" 2>/dev/null || break; done
    if [ "$4" = "off" ]; then
        $1 -F "$3" 2>/dev/null; $1 -X "$3" 2>/dev/null
    else
        $1 -I "$2" 1 -j "$3"
    fi
}

stealth_stop() {
    for t in $(wan_tables); do
        _hook "$t" INPUT "$ST_IN" off
        _hook "$t" OUTPUT "$ST_OUT" off
    done
}

stealth_start() {
    stealth_stop
    [ -f "$STEALTH_FLAG" ] || return 0
    iptables -N "$ST_IN" 2>/dev/null
    iptables -A "$ST_IN" -i rmnet+ -p icmp --icmp-type echo-request -j DROP
    iptables -N "$ST_OUT" 2>/dev/null
    iptables -A "$ST_OUT" -o rmnet+ -p icmp --icmp-type port-unreachable -j DROP
    iptables -A "$ST_OUT" -o rmnet+ -p icmp --icmp-type protocol-unreachable -j DROP
    # Only resets in the REPLY direction (answers to probes from outside). Resets on connections the
    # modem opened itself (Traffic Engine, Tailscale, curl) go out, so they never hang half-open.
    iptables -A "$ST_OUT" -o rmnet+ -p tcp --tcp-flags RST RST -m conntrack --ctdir REPLY -j DROP 2>/dev/null \
        || iptables -A "$ST_OUT" -o rmnet+ -p tcp --tcp-flags RST RST -j DROP
    _hook iptables INPUT "$ST_IN" on
    _hook iptables OUTPUT "$ST_OUT" on
    command -v ip6tables >/dev/null 2>&1 || return 0
    # Neighbour discovery, router advertisements and packet-too-big are left alone: IPv6 needs them.
    ip6tables -N "$ST_IN" 2>/dev/null
    ip6tables -A "$ST_IN" -i rmnet+ -p ipv6-icmp --icmpv6-type echo-request -j DROP
    ip6tables -N "$ST_OUT" 2>/dev/null
    ip6tables -A "$ST_OUT" -o rmnet+ -p ipv6-icmp --icmpv6-type port-unreachable -j DROP
    ip6tables -A "$ST_OUT" -o rmnet+ -p tcp --tcp-flags RST RST -m conntrack --ctdir REPLY -j DROP 2>/dev/null \
        || ip6tables -A "$ST_OUT" -o rmnet+ -p tcp --tcp-flags RST RST -j DROP
    _hook ip6tables INPUT "$ST_IN" on
    _hook ip6tables OUTPUT "$ST_OUT" on
}

lan6_stop() {
    command -v ip6tables >/dev/null 2>&1 || return 0
    _hook ip6tables FORWARD "$LAN6_FWD" off
    _hook ip6tables OUTPUT "$LAN6_OUT" off
}

lan6_start() {
    lan6_stop
    [ -f "$LAN6_FLAG" ] || return 0
    command -v ip6tables >/dev/null 2>&1 || return 0
    ip6tables -N "$LAN6_FWD" 2>/dev/null
    # REJECT makes devices that still hold an IPv6 address fall back to IPv4 at once.
    ip6tables -A "$LAN6_FWD" -i bridge0 -j REJECT --reject-with icmp6-adm-prohibited 2>/dev/null \
        || ip6tables -A "$LAN6_FWD" -i bridge0 -j DROP
    ip6tables -A "$LAN6_FWD" -o bridge0 -j DROP
    ip6tables -N "$LAN6_OUT" 2>/dev/null
    ip6tables -A "$LAN6_OUT" -o bridge0 -p ipv6-icmp --icmpv6-type router-advertisement -j DROP
    ip6tables -A "$LAN6_OUT" -o bridge0 -p udp --sport 547 -j DROP
    _hook ip6tables FORWARD "$LAN6_FWD" on
    _hook ip6tables OUTPUT "$LAN6_OUT" on
}

# _hooked <tool> <builtin chain> <our chain> — is the jump in place?
_hooked() { $1 -C "$2" -j "$3" 2>/dev/null; }

# ensure — put back what a QCMAP firewall reload flushed (the poller calls this every 2 minutes).
# Covers every chain this script owns, not only the optional ones: a flush that took the web UI
# protection (IPv4 or IPv6) or the closed ports with it must not leave them open until a reboot.
# Any mismatch rebuilds everything with do_start, which is idempotent and keeps the hook order.
do_ensure() {
    local have6=0
    command -v ip6tables >/dev/null 2>&1 && have6=1
    _hooked iptables INPUT "$CHAIN" || { do_start; return 0; }
    if [ "$have6" = 1 ]; then _hooked ip6tables INPUT "$CHAIN" || { do_start; return 0; }; fi
    if [ -s "$WAN_CONF" ]; then
        _hooked iptables INPUT "$WAN_CHAIN" || { do_start; return 0; }
    fi
    if [ -f "$STEALTH_FLAG" ]; then
        _hooked iptables INPUT "$ST_IN" || { do_start; return 0; }
    else
        _hooked iptables INPUT "$ST_IN" && { do_start; return 0; }
    fi
    if [ "$have6" = 1 ]; then
        if [ -f "$LAN6_FLAG" ]; then
            _hooked ip6tables FORWARD "$LAN6_FWD" || { do_start; return 0; }
        else
            _hooked ip6tables FORWARD "$LAN6_FWD" && { do_start; return 0; }
        fi
    fi
    return 0
}

do_stop() {
    unhook_chain
    drop_chain
    cleanup_legacy_input_rules
    web6_stop
    wan_stop
    stealth_stop
    lan6_stop
}

case "${1:-}" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; do_start ;;
    ensure)  do_ensure ;;
    *)
        echo "Usage: qmanager_firewall {start|stop|restart|ensure}" >&2
        exit 1
        ;;
esac
